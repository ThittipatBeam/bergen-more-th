# Copy this file to site/.env, then fill ONE provider block.
# site/.env is gitignored; never commit real credentials.
#
# The endpoint uses the first configured provider in this order:
# webhook -> SMTP -> Resend -> Notion.

# --- Microsoft 365 / company Outlook (SMTP) --------------------------------
# Host is smtp.office365.com for Microsoft 365 and smtp-mail.outlook.com for
# a personal outlook.com account. SMTP AUTH must be enabled on the mailbox.
# With MFA enabled, use an app password for REQUEST_SMTP_PASS.
REQUEST_SMTP_HOST=smtp.office365.com
REQUEST_SMTP_PORT=587
REQUEST_SMTP_USER=
REQUEST_SMTP_PASS=
REQUEST_FROM_EMAIL=
REQUEST_INBOX_EMAIL=

# --- Webhook (n8n, Zapier, Power Automate, Slack, Apps Script) --------------
# Power Automate can send the email from Outlook without SMTP AUTH.
# Google Sheets: see scripts/google-sheet-webhook.gs for a ready-made receiver.
# REQUEST_WEBHOOK_URL=

# --- Resend ----------------------------------------------------------------
# REQUEST_FROM_EMAIL must be an address on a verified Resend domain in
# production; onboarding@resend.dev only delivers to the account owner.
# RESEND_API_KEY=
# REQUEST_INBOX_EMAIL=

# --- Notion database --------------------------------------------------------
# The database needs properties: Name, Contact, Email, Generator,
# Embedding, Reranker, Notes.
# NOTION_TOKEN=
# NOTION_REQUESTS_DATABASE_ID=
