# BERGEN API keys - copy to .env and fill in the ones you use.
# .env is gitignored; never commit keys, even "test" ones.
# Real environment variables (exports) take precedence over .env entries.

# ============================ shared / default ============================
# Default key used by everything below unless a component-specific one is set.
# Also the key for OpenAI's own API (gpt-4o generator, text-embedding-3-*).
OPENAI_API_KEY=
# Default base URL for any OpenAI-compatible component that doesn't set its own.
# OPENAI_BASE_URL=http://localhost:4000/v1

# ===================== per-component overrides ============================
# Use these when the LLM, embedder and reranker live on DIFFERENT servers
# (e.g. embed via OpenAI, rerank via TEI on localhost, LLM via Together).
# Leave empty to fall back to the shared vars above.

# LLM generator (config/generator/openai_*.yaml targets models.generators.llm_openai)
LLM_BASE_URL=
LLM_API_KEY=

# Embedding retriever (config/retriever/api-embed-openai-*.yaml)
EMBED_BASE_URL=
EMBED_API_KEY=

# Reranker (config/reranker/api-rerank-openai-compatible.yaml)
RERANK_BASE_URL=
RERANK_API_KEY=

# LLM-as-judge (python3 evaluate.py --judge)
# Scores a finished run 0/1 per question against the retrieved context.
# Falls back to OPENAI_BASE_URL / OPENAI_API_KEY when left empty, so pointing
# the judge at the same gateway as everything else needs no extra config.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
# in-flight judge requests (default 4)
JUDGE_CONCURRENCY=

# ============ one gateway for everything (e.g. LiteLLM) ===================
# If you proxy all models through one server (LiteLLM, internal gateway),
# don't touch the per-component vars - just point everything at the gateway:
#   OPENAI_BASE_URL=http://localhost:4000/v1
#   OPENAI_API_KEY=<litellm master or virtual key>
# Note: LiteLLM rerank support depends on the deployment - if your gateway's
# /rerank is Cohere/TEI-shaped, api-rerank-openai-compatible works against it.

# ==================== all-Cohere (LLM + embed + rerank) ====================
# One real secret: COHERE_API_KEY. Cohere's LLM chat is exposed through its
# OpenAI-compatibility endpoint, so reuse the same key for the generator:
#   LLM_BASE_URL=https://api.cohere.ai/compatibility/v1
#   LLM_API_KEY=${COHERE_API_KEY}
# (${VAR} interpolation works because python-dotenv reads this file.)
# Then run with retriever=api-embed-cohere-embed-multilingual-v3,
# reranker=api-rerank-cohere-rerank-v3, generator=cohere_command_a.

# ==================== dedicated provider keys =============================
# Cohere embed-multilingual-v3 + rerank-multilingual-v3.0 (recommended for Thai)
COHERE_API_KEY=

# Voyage
VOYAGE_API_KEY=

# Google Gemini embeddings
GOOGLE_API_KEY=

# Jina rerank
JINA_API_KEY=

# ============================== misc ======================================
# skip the interactive API-cost confirmation prompt everywhere
# BERGEN_API_CONFIRM=1
