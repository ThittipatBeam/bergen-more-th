# .env — edit these values, then run BERGEN. Copy this file to ".env".
# .env is gitignored; never commit keys. Exported env vars override .env entries.

# ---------------------------------------------------------------------------
# START HERE — this is all most setups need.
# One OpenAI-compatible server (OpenAI, LiteLLM, vLLM, Together, local proxy)
# serving chat + embeddings (+ rerank). Everything else falls back to these.
# ---------------------------------------------------------------------------
OPENAI_BASE_URL=            # e.g. http://localhost:4000/v1
OPENAI_API_KEY=

# Models to test — the model ids your endpoint serves.
LLM_MODEL=                  # chat model       (default: the generator yaml's model_name)
EMBED_MODEL=                # embedding model  (default: the retriever yaml's model_name)
RERANK_MODEL=               # rerank model     (default: the reranker yaml's model_name)
JUDGE_MODEL=                # judge model for `evaluate.py --judge` (REQUIRED to judge)

# Example (LiteLLM gateway):
#   OPENAI_BASE_URL=http://localhost:4000/v1
#   OPENAI_API_KEY=sk-litellm-...
#   LLM_MODEL=gpt-4o-mini
#   EMBED_MODEL=BAAI/bge-m3
#   RERANK_MODEL=BAAI/bge-reranker-v2-m3
#   JUDGE_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# ADVANCED — per-component overrides. Only fill these when the LLM, embedder,
# reranker or judge live on DIFFERENT servers. Empty = use the shared vars above.
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=

EMBED_BASE_URL=
EMBED_API_KEY=

RERANK_BASE_URL=
RERANK_API_KEY=

JUDGE_BASE_URL=
JUDGE_API_KEY=
# JUDGE_CONCURRENCY=4       # in-flight judge requests

# ---------------------------------------------------------------------------
# OTHER PROVIDERS — ignore unless you use their native SDK configs
# (config/retriever/api-embed-cohere-*.yaml, api-rerank-voyage-2.yaml, ...).
# ---------------------------------------------------------------------------
# COHERE_API_KEY=           # LLM too: LLM_BASE_URL=https://api.cohere.ai/compatibility/v1  LLM_API_KEY=${COHERE_API_KEY}
# VOYAGE_API_KEY=
# GOOGLE_API_KEY=           # Gemini embeddings
# JINA_API_KEY=             # rerank only

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------
# BERGEN_API_CONFIRM=1      # skip the interactive API-cost confirmation prompt
# LLM_CONCURRENCY=8         # parallel generation requests
# EMBED_DOC_BATCH=96        # docs per embedding request (lower if your endpoint 422s)
# WIKI_CHUNK_WORDS=100      # Wikipedia chunk size in words (default 100). Only used
#                           # by Wiki_monolingual_100w-based datasets when their config
#                           # doesn't set num_words. Non-100 sizes rename the corpus
#                           # (wiki-1000w-th, ...), giving fresh datasets/indexes/runs
#                           # so chunk sizes can be compared without overwriting.
#                           # Prefer the per-size config files (e.g.
#                           # config/dataset/mkqa/mkqa_th-chunk1000.retrieve_th.yaml)
#                           # for reproducible comparisons; this env var is a shortcut.
